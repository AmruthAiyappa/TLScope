# TLScope Environment Configuration Example
# Copy to .env and adjust variables as required

TLSCOPE_SECRET_KEY=change-this-in-production-to-a-secure-random-key
TLSCOPE_DB_PATH=database/tlscope.db

# Network timeouts (in seconds)
TLSCOPE_CONNECT_TIMEOUT=6.0
TLSCOPE_READ_TIMEOUT=6.0

# SSRF Protection: Set to True ONLY in isolated test environments with local fixtures
TLSCOPE_ALLOW_PRIVATE_IPS=False

# Flask Port (default: 5000)
PORT=5000
